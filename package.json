{
  "name": "mail-canvas",
  "version": "0.1.0",
  "description": "AI-era email verification runtime with fast Rust/WASM rendering and QA diagnostics.",
  "private": true,
  "scripts": {
    "render": "cargo run -p mail-canvas-cli -- render",
    "profiles": "cargo run -p mail-canvas-cli -- profiles",
    "preview": "node scripts/mail_canvas_tools.mjs preview",
    "diff": "node scripts/mail_canvas_tools.mjs diff",
    "snapshot": "node scripts/mail_canvas_tools.mjs snapshot",
    "check": "node scripts/mail_canvas_tools.mjs check",
    "build:browser": "bash scripts/build_wasm_browser.sh",
    "test:tools": "node scripts/test_mail_canvas_tools.mjs",
    "test:visual": "node scripts/playwright_compare.mjs --expectations scripts/playwright_expectations.json --work-dir /tmp/mail-canvas-playwright-regression --timeout-ms 30000 --no-remote --fixture-fonts",
    "test:wasm-thumbnail": "node scripts/test_wasm_thumbnail.mjs",
    "perf:memory": "node scripts/benchmark_memory.mjs",
    "perf:repeated-image": "node scripts/benchmark_memory.mjs --case repeated-image --width 800",
    "perf:thumbnail": "node scripts/benchmark_memory.mjs --case thumbnail-800x1200",
    "perf:wasm-thumbnail": "node scripts/benchmark_wasm_thumbnail.mjs",
    "dev:demo": "npm run build:browser && node scripts/serve_demo.mjs",
    "dev:serve-http": "node examples/http-service.mjs",
    "dev:fonts-download": "node scripts/download_fonts.mjs",
    "dev:layout:chrome": "node scripts/playwright_layout_dump.mjs",
    "dev:layout:compare": "node scripts/compare_layout_rects.mjs",
    "research:audit": "node scripts/audit_corpus.mjs",
    "research:manifest": "node scripts/export_corpus_manifest.mjs",
    "research:registry": "node scripts/corpus_registry.mjs refresh",
    "research:pipeline": "node scripts/corpus_pipeline.mjs",
    "corpus:index": "node scripts/rge_corpus_store.mjs index",
    "corpus:run": "node scripts/rge_corpus_store.mjs run",
    "corpus:report": "node scripts/rge_corpus_store.mjs report",
    "corpus:list": "node scripts/rge_corpus_store.mjs list",
    "research:vendor-rge": "node scripts/vendor_reallygoodemails.mjs",
    "research:vendor-rge-all": "node scripts/vendor_reallygoodemails_all.mjs",
    "research:compare:local-rge": "node scripts/compare_local_rge_corpus.mjs",
    "research:compare:local-rge-new": "node scripts/compare_local_rge_corpus.mjs --exclude-seen --update-seen-registry",
    "research:vendor-mjml": "node scripts/vendor_mjml_official_templates.mjs",
    "research:compare:golden": "node scripts/playwright_compare.mjs --expectations scripts/playwright_expectations.json --work-dir /tmp/mail-canvas-playwright-corpus --timeout-ms 30000 --all --no-remote --corpus-group golden",
    "research:compare:editors": "node scripts/playwright_compare.mjs --work-dir /tmp/mail-canvas-playwright-editors --timeout-ms 30000 --width 800 --all --no-remote --fixture-fonts --provider mjml --provider emailoctopus",
    "research:compare:local": "node scripts/playwright_compare.mjs --work-dir /tmp/mail-canvas-playwright-local --timeout-ms 30000 --width 800 --no-remote --fixture-fonts",
    "research:compare:rge": "node scripts/corpus_pipeline.mjs --provider reallygoodemails --collection latest --limit 12 --include-seen --max-image-bytes 20971520 --max-decoded-pixels 50000000 --max-total-resource-bytes 134217728"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "type": "commonjs",
  "devDependencies": {
    "pixelmatch": "^7.2.0",
    "playwright": "^1.59.1",
    "pngjs": "^7.0.0"
  }
}
