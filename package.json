{
  "name": "mail-canvas",
  "version": "0.1.0",
  "description": "Chrome-free HTML/CSS email template renderer for PNG and raster PDF output.",
  "private": true,
  "scripts": {
    "benchmark:memory": "node scripts/benchmark_memory.mjs",
    "build:demo": "bash scripts/build_wasm_demo.sh",
    "compare:playwright": "node scripts/playwright_compare.mjs --expectations scripts/playwright_expectations.json --work-dir /tmp/mail-canvas-playwright-compare --timeout-ms 30000 --all --no-remote",
    "compare:layout-rects": "node scripts/compare_layout_rects.mjs",
    "corpus:manifest": "node scripts/export_corpus_manifest.mjs",
    "demo": "npm run build:demo && node scripts/serve_demo.mjs",
    "dump:chrome-layout": "node scripts/playwright_layout_dump.mjs",
    "test:playwright-all": "node scripts/playwright_compare.mjs --expectations scripts/playwright_expectations.json --work-dir /tmp/mail-canvas-playwright-all --timeout-ms 30000 --all --no-remote",
    "test:playwright-corpus": "node scripts/playwright_compare.mjs --expectations scripts/playwright_expectations.json --work-dir /tmp/mail-canvas-playwright-corpus --timeout-ms 30000 --all --no-remote",
    "test:playwright-regression": "node scripts/playwright_compare.mjs --expectations scripts/playwright_expectations.json --work-dir /tmp/mail-canvas-playwright-regression --timeout-ms 30000 --no-remote"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "type": "commonjs",
  "devDependencies": {
    "pixelmatch": "^7.2.0",
    "playwright": "^1.59.1",
    "pngjs": "^7.0.0"
  }
}
