{
  "name": "mail-canvas",
  "version": "0.1.0",
  "description": "Chrome-free HTML/CSS email template renderer for PNG and raster PDF output.",
  "private": true,
  "scripts": {
    "benchmark:memory": "node scripts/benchmark_memory.mjs",
    "benchmark:repeated-image": "node scripts/benchmark_memory.mjs --case repeated-image --width 800",
    "benchmark:thumbnail": "node scripts/benchmark_memory.mjs --case thumbnail-800x1200",
    "build:demo": "bash scripts/build_wasm_demo.sh",
    "compare:corpus": "node scripts/playwright_compare.mjs --expectations scripts/playwright_expectations.json --work-dir /tmp/mail-canvas-playwright-corpus --timeout-ms 30000 --all --no-remote --corpus-group golden",
    "compare:dirty": "node scripts/playwright_compare.mjs --work-dir /tmp/mail-canvas-playwright-dirty --timeout-ms 30000 --width 800 --all --no-remote --fixture-fonts --corpus-group real-world-dirty",
    "compare:editors": "node scripts/playwright_compare.mjs --work-dir /tmp/mail-canvas-playwright-editors --timeout-ms 30000 --width 800 --all --no-remote --fixture-fonts --provider beefree --provider stripo --provider mjml",
    "compare:local": "node scripts/playwright_compare.mjs --work-dir /tmp/mail-canvas-playwright-local --timeout-ms 30000 --width 800 --no-remote --fixture-fonts",
    "corpus:audit": "node scripts/audit_corpus.mjs",
    "corpus:manifest": "node scripts/export_corpus_manifest.mjs",
    "corpus:vendor-mjml": "node scripts/vendor_mjml_official_templates.mjs",
    "demo": "npm run build:demo && node scripts/serve_demo.mjs",
    "layout:chrome": "node scripts/playwright_layout_dump.mjs",
    "layout:compare": "node scripts/compare_layout_rects.mjs",
    "test:visual": "node scripts/playwright_compare.mjs --expectations scripts/playwright_expectations.json --work-dir /tmp/mail-canvas-playwright-regression --timeout-ms 30000 --no-remote --fixture-fonts"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "type": "commonjs",
  "devDependencies": {
    "pixelmatch": "^7.2.0",
    "playwright": "^1.59.1",
    "pngjs": "^7.0.0"
  }
}
