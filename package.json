{
  "name": "mail-canvas",
  "version": "0.1.0",
  "description": "AI-era email verification runtime with fast Rust/WASM rendering and QA diagnostics.",
  "private": true,
  "scripts": {
    "benchmark:memory": "node scripts/benchmark_memory.mjs",
    "benchmark:repeated-image": "node scripts/benchmark_memory.mjs --case repeated-image --width 800",
    "benchmark:thumbnail": "node scripts/benchmark_memory.mjs --case thumbnail-800x1200",
    "benchmark:wasm-thumbnail": "node scripts/benchmark_wasm_thumbnail.mjs",
    "build:browser": "bash scripts/build_wasm_browser.sh",
    "build:demo": "npm run build:browser",
    "check": "node scripts/mail_canvas_tools.mjs check",
    "compare:corpus": "node scripts/playwright_compare.mjs --expectations scripts/playwright_expectations.json --work-dir /tmp/mail-canvas-playwright-corpus --timeout-ms 30000 --all --no-remote --corpus-group golden",
    "compare:dirty": "node -e \"console.log('Dirty/research templates are registry-tracked but not committed; use npm run corpus:pipeline for temporary batches.')\"",
    "compare:editors": "node scripts/playwright_compare.mjs --work-dir /tmp/mail-canvas-playwright-editors --timeout-ms 30000 --width 800 --all --no-remote --fixture-fonts --provider mjml --provider emailoctopus",
    "compare:local": "node scripts/playwright_compare.mjs --work-dir /tmp/mail-canvas-playwright-local --timeout-ms 30000 --width 800 --no-remote --fixture-fonts",
    "compare:rge": "node scripts/corpus_pipeline.mjs --provider reallygoodemails --collection latest --limit 12 --include-seen --max-image-bytes 20971520 --max-decoded-pixels 50000000 --max-total-resource-bytes 134217728",
    "corpus:audit": "node scripts/audit_corpus.mjs",
    "corpus:manifest": "node scripts/export_corpus_manifest.mjs",
    "corpus:pipeline": "node scripts/corpus_pipeline.mjs",
    "corpus:registry": "node scripts/corpus_registry.mjs refresh",
    "corpus:rge": "node scripts/vendor_reallygoodemails.mjs",
    "corpus:vendor-mjml": "node scripts/vendor_mjml_official_templates.mjs",
    "demo": "npm run build:browser && node scripts/serve_demo.mjs",
    "diff": "node scripts/mail_canvas_tools.mjs diff",
    "fonts:download": "node scripts/download_fonts.mjs",
    "layout:chrome": "node scripts/playwright_layout_dump.mjs",
    "layout:compare": "node scripts/compare_layout_rects.mjs",
    "preview": "node scripts/mail_canvas_tools.mjs preview",
    "serve:http": "node examples/http-service.mjs",
    "snapshot": "node scripts/mail_canvas_tools.mjs snapshot",
    "test:tools": "node scripts/test_mail_canvas_tools.mjs",
    "test:visual": "node scripts/playwright_compare.mjs --expectations scripts/playwright_expectations.json --work-dir /tmp/mail-canvas-playwright-regression --timeout-ms 30000 --no-remote --fixture-fonts",
    "test:wasm-thumbnail": "node scripts/test_wasm_thumbnail.mjs"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "type": "commonjs",
  "devDependencies": {
    "pixelmatch": "^7.2.0",
    "playwright": "^1.59.1",
    "pngjs": "^7.0.0"
  }
}
